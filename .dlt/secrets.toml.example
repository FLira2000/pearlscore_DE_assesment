# Copy to secrets.toml (gitignored) or export equivalent env vars.
#
#   cp .dlt/secrets.toml.example .dlt/secrets.toml
#
# Env-var form (used by scripts/bootstrap.sh):
#   export SOURCES__SQL_DATABASE__CREDENTIALS="mysql+pymysql://billing_user:billing_password@127.0.0.1:3306/billing"
#   export DESTINATION__POSTGRES__CREDENTIALS="postgresql://dbt_user:dbt_password@127.0.0.1:5432/analytics"

[sources.sql_database.credentials]
drivername = "mysql+pymysql"
database = "billing"
username = "billing_user"
password = "billing_password"
host = "127.0.0.1"
port = 3306

[destination.postgres.credentials]
database = "analytics"
username = "dbt_user"
password = "dbt_password"
host = "127.0.0.1"
port = 5432
connect_timeout = 15
